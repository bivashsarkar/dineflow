# DineFlow Backend Environment Configuration
# Copy this file to `.env` and fill in your production values.
# Secrets are never shipped to the frontend.

# === Core ===
DINEFLOW_SECRET_KEY=your-super-secret-key-change-me
DINEFLOW_DEBUG=False
DINEFLOW_HOST=0.0.0.0
DINEFLOW_PORT=5000

# === Super Admin Credentials ===
# Used only for the platform super-admin login page.
# These are stored server-side in auth_sessions, never exposed to the frontend.
DINEFLOW_ADMIN_USERNAME=your-admin-username
DINEFLOW_ADMIN_PASSWORD=your-admin-password

# === Database ===
# DB_BACKEND: auto|firestore|local
#   auto  -> Firestore if credentials exist, else local (default)
#   firestore -> Production Firestore (requires FIREBASE_CREDENTIALS)
#   local      -> JSON files (development / testing)
DINEFLOW_DB_BACKEND=auto

# === Firestore (Firebase Admin SDK) ===
# Required when DINEFLOW_DB_BACKEND=firestore or DINEFLOW_DB_BACKEND=auto with creds
# Place a Firebase service account JSON file and point to it.
FIREBASE_CREDENTIALS=./firebase-service-account.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# === Cloudinary Image Storage ===
# When CLOUDINARY_* vars are set, images upload to Cloudinary.
# When empty, images save to ./uploads/ served at /uploads/<file>
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# === Optional: Override Cloudinary upload folder ===
DINEFLOW_UPLOAD_FOLDER=./uploads

# === GST (Goods and Services Tax) ===
# Restaurant-level GST rate applied to bills (percentage)
DINEFLOW_GST_RATE=5.0

# === Auth Session TTL ===
# How long (in hours) a session token remains valid
DINEFLOW_SESSION_TTL_HOURS=12

# === Public Base URL ===
# Used when building QR codes; set to your production domain
DINEFLOW_PUBLIC_BASE_URL=https://your-production-domain.com

# === Optional: Google Application Default Credentials ===
# If you rely on ADC (e.g., gcloud auth), set this path or leave empty
# GOOGLE_APPLICATION_CREDENTIALS=./path/to/service-account.json